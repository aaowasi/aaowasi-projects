  "telemetry_sources": ["Questionnaire import", "Control library", "Evidence graph", "Exception register", "Approval log"],
  "outputs": ["normalized-questions.json", "draft-responses.json", "unsupported-claims.json", "approval-record.json"],
  "kpis": ["Evidence-supported answers %", "Median turnaround time", "Manual review rate", "Stale answer reuse prevented"],
  "guardrails": ["Never fabricate a control or certification", "NO_CURRENT_EVIDENCE is an acceptable result", "Legal and contractual claims require approval"]
